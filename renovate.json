{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "description": "Update the bundled tools' versions and SHA-256 sums",
      "managerFilePatterns": [
        "/^cmd/fetch-tools/tools\\.json$/"
      ],
      "matchStrings": [
        "tools.{ \"depName\": name, \"packageName\": repo, \"currentValue\": version, \"currentDigest\": sha256 }"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "eugeneware/ffmpeg-static"
      ],
      "groupName": "FFmpeg static tools"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": false
    }
  ]
}
